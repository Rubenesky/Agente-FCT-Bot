ADZUNA_APP_ID=your-adzuna-app-id
ADZUNA_API_KEY=your-adzuna-api-key
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id

# Obligatoria - proveedor principal de clasificación (classifier.py). Nivel
# gratuito real, sin tarjeta de crédito. Cómo conseguirla: regístrate en
# console.groq.com y crea una API key.
GROQ_API_KEY=your-groq-api-key

# Opcional - respaldo si Groq falla del todo (classifier.py). Sin ella, el
# respaldo se omite (log de aviso) y la clasificación depende solo de Groq.
# Cómo conseguirla: regístrate en openrouter.ai (tampoco requiere tarjeta) y
# crea una API key.
OPENROUTER_API_KEY=your-openrouter-api-key

# Opcional - la usa search_jooble (main.py) para buscar en el agregador
# Jooble (cobertura España). Sin ella, esa fuente queda desactivada (no se
# hace ninguna llamada HTTP) y el resto de fuentes siguen funcionando igual.
# Cómo conseguirla: regístrate en es.jooble.org/api/about (formulario
# self-service); la key llega por email.
JOOBLE_API_KEY=your-jooble-api-key

# Opcional - solo lo usa controller.py (bot de Telegram en Render) para
# comitear y pushear offers.db a git tras cada aprobación/descarte, ya que
# Render no tiene disco persistente. Sin esta variable el bot funciona
# igual, pero las decisiones no se sincronizan con git.
# Cómo generarlo: GitHub -> Settings -> Developer settings -> Personal
# access tokens -> Fine-grained tokens -> New token, con acceso solo a este
# repositorio y permiso "Contents: Read and write" (o, si usas un token
# clásico, el scope "repo").
GIT_PUSH_TOKEN=your-github-personal-access-token
